CompileFlags:
  CompilationDatabase: .
  Remove:
    - -mlongcalls
    - -fno-tree-switch-conversion
    - -fstrict-volatile-bitfields
    - -mdisable-hardware-atomics
  Add:
    - --target=riscv32-unknown-elf
    - -U__riscv
    - -D__XTENSA__=1
    - -D__XTENSA_EL__=1
    - -D__XTENSA_WINDOWED_ABI__=1
    - -isystem/Users/bluestoneadmin/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include/c++/14.2.0
    - -isystem/Users/bluestoneadmin/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include/c++/14.2.0/xtensa-esp-elf/esp32s3
    - -isystem/Users/bluestoneadmin/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include/c++/14.2.0/backward
    - -isystem/Users/bluestoneadmin/.platformio/packages/toolchain-xtensa-esp-elf/lib/gcc/xtensa-esp-elf/14.2.0/include
    - -isystem/Users/bluestoneadmin/.platformio/packages/toolchain-xtensa-esp-elf/lib/gcc/xtensa-esp-elf/14.2.0/include-fixed
    - -isystem/Users/bluestoneadmin/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include
    - -fno-blocks
    - -Wno-unknown-warning-option
